{
  "name": "persona-memory-diary",
  "version": "0.1.0",
  "description": "Persona-aware long-term memory for chat characters: persona core, event diary, long-term facts and session handoff, all in plain JSONL/Markdown.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./persona-core": "./src/persona-core.js",
    "./persona-draft": "./src/persona-draft.js",
    "./diary": "./src/diary.js",
    "./facts": "./src/facts.js",
    "./handoff": "./src/handoff.js"
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "examples",
    "persona-core/_template.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test-persona-core.mjs && node scripts/test-persona-draft.mjs && node scripts/test-diary.mjs && node scripts/test-facts.mjs && node scripts/test-handoff.mjs",
    "preview:core": "node scripts/preview-persona-core.mjs",
    "preview:diary": "node scripts/preview-diary.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chatbot",
    "persona",
    "memory",
    "long-term-memory",
    "diary",
    "llm",
    "context-compression"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedkitten/persona-memory-diary.git"
  },
  "homepage": "https://github.com/firedkitten/persona-memory-diary#readme",
  "bugs": {
    "url": "https://github.com/firedkitten/persona-memory-diary/issues"
  },
  "license": "MIT"
}
